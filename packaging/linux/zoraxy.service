[Unit]
Description=Zoraxy reverse proxy and forwarding tool
Documentation=https://github.com/tobychui/zoraxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zoraxy
Group=zoraxy
# Zoraxy keeps its data (sys.db, conf/, log/, plugins/, www/) in the working directory
WorkingDirectory=/var/lib/zoraxy
# Command line options: /etc/default/zoraxy (deb) or /etc/sysconfig/zoraxy (rpm)
EnvironmentFile=-/etc/default/zoraxy
EnvironmentFile=-/etc/sysconfig/zoraxy
ExecStart=/usr/bin/zoraxy $ZORAXY_OPTS
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

# Bind ports 80/443 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
